# -----------------------------------------------------------------------------
# A Detail — required environment variables
# Copy this file to .env.local and fill in real values. Do not commit secrets.
# -----------------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth + database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (for Supabase Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar (SEPARATE OAuth client from the Google sign-in one above —
# do not reuse those credentials here). Used by src/lib/google/calendar.ts to
# create Calendar events for bookings. The refresh token itself is stored in
# Supabase (google_calendar_tokens table), not here.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Stripe (payments — test mode keys to start)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio (SMS confirmations/reminders — build last)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cron (protects /api/cron/* routes — Vercel sends this as a Bearer token
# automatically when CRON_SECRET is also set in the Vercel project's env vars)
CRON_SECRET=
